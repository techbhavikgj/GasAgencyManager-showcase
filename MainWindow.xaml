<Window x:Class="GasAgencyManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Gas Agency Manager"
        
        Height="900" Width="1000" WindowStartupLocation="CenterScreen" WindowState="Maximized" MinWidth="900" MinHeight="650">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Warehouse Selector Bar (Top) -->
        <Border Grid.Row="0" Background="#FDFEFE" Padding="15" BorderBrush="#D5DBDB" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Label Content="Active Warehouse:" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Width="140" Foreground="#2C3E50"/>
                    <ComboBox x:Name="WarehouseCombo" Width="300" Height="35" VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="CurrentUserText" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="#566573" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EBF5FB" Padding="12,6" CornerRadius="4" Margin="0,0,10,0" BorderBrush="#AED6F1" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Working Date:" FontWeight="Bold" Foreground="#21618C" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="BusinessDateText" FontWeight="Bold" Foreground="#1A5276" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F4F6F7" Padding="12,6" CornerRadius="4" Margin="0,0,10,0" BorderBrush="#D5DBDB" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="System Date:" FontWeight="Bold" Foreground="#5D6D7E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="SystemDateText" Foreground="#2C3E50" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="DayEndButton" Content="Day End" Click="DayEndButton_Click" Background="#8E44AD" Foreground="White" FontWeight="Bold" Height="35" Width="100" ToolTip="Complete day-end operations and move to the next working date"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main TabControl -->
        <TabControl Grid.Row="1" Margin="0" x:Name="MainTabControl">
            <!-- IOCL Plant Purchases Tab -->
            <TabItem x:Name="IoclPlantTab" Header="IOCL Plant Purchase" Padding="10,5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <TextBlock Text="IOCL Plant Purchase (Bulk Receive)" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="#21618C"/>

                        <Border Background="#EBF5FB" Padding="15" CornerRadius="5" BorderBrush="#AED6F1" BorderThickness="1" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Select Products to Receive:" FontSize="12" FontWeight="Bold" Margin="0,0,0,10" Foreground="#21618C"/>

                                <!-- Column Headers -->
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Product" Grid.Column="0" FontWeight="Bold" FontSize="10" Foreground="#2C3E50"/>
                                    <TextBlock Text="Filled Recv" Grid.Column="1" FontWeight="Bold" FontSize="10" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Return Qty" Grid.Column="2" FontWeight="Bold" FontSize="10" Foreground="#E74C3C" HorizontalAlignment="Center"/>
                                </Grid>

                                <ItemsControl x:Name="PlantProductEntryList" Height="150">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Width="160">
                                                    <TextBlock Text="{Binding ProductName}" FontSize="10"/>
                                                </CheckBox>
                                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="20" VerticalContentAlignment="Center" FontSize="10" HorizontalAlignment="Center"/>
                                                <TextBox Text="{Binding ReturnQty, UpdateSourceTrigger=PropertyChanged}" Width="130" Height="20" VerticalContentAlignment="Center" FontSize="10" Margin="5,0,0,0" Background="#FADBD8" ToolTip="Qty being returned to IOCL"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <StackPanel x:Name="PlantReasonPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                    <Label Content="Shortage Reason:" Padding="0,0,0,2" FontSize="11" Foreground="Red" FontWeight="Bold"/>
                                    <ComboBox x:Name="PlantShortageReason" Width="250" Height="28">
                                        <ComboBoxItem Content="One Way Load"/>
                                        <ComboBoxItem Content="Cylinder Damaged"/>
                                        <ComboBoxItem Content="Security Deposit"/>
                                        <ComboBoxItem Content="Transfer Agency"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                    <Label Content="Cylinder Status Being Returned:" VerticalAlignment="Center" Padding="0,0,0,2" FontSize="11" FontWeight="Bold" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="PlantReturnTypeCombo" Width="220" Height="28">
                                        <ComboBoxItem Content="Return Empty Cylinders" Tag="RETURN_EMPTY"/>
                                        <ComboBoxItem Content="Return Filled Cylinders" Tag="RETURN_FILLED"/>
                                    </ComboBox>
                                </StackPanel>

                                <Button x:Name="ReceivePlantLoadButton" Content="Receive Load" Click="ReceivePlantLoad_Click" Background="#27AE60" Foreground="White" Width="150" Height="35" Margin="0,15,0,0" FontWeight="Bold" IsEnabled="False"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Current Warehouse Stock" FontSize="13" FontWeight="Bold" Margin="0,15,0,10" Foreground="#2C3E50"/>
                        <DataGrid x:Name="PlantStockDataGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="White" Height="200" BorderBrush="#D5DBDB">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cylinder Type" Binding="{Binding CylinderType}" Width="*"/>
                                <DataGridTextColumn Header="Filled" Binding="{Binding FilledQty}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Empty" Binding="{Binding EmptyQty}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border x:Name="PlantReversalPanel" Visibility="Collapsed" Background="#FDEDEC" Padding="15" CornerRadius="5" BorderBrush="#E74C3C" BorderThickness="1" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="Reverse Mistaken IOCL Entry (Owner Only)" FontSize="14" FontWeight="Bold" Foreground="#C0392B" Margin="0,0,0,10"/>
                                <TextBlock Text="Select a recent IOCL plant purchase below, choose a reason, and reverse it. Stock will be corrected automatically." TextWrapping="Wrap" Foreground="#7B241C" Margin="0,0,0,10"/>

                                <DataGrid x:Name="PlantPurchaseHistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="White" Height="180" BorderBrush="#D5DBDB" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Date/Time" Binding="{Binding Timestamp}" Width="140"/>
                                        <DataGridTextColumn Header="Product" Binding="{Binding CylinderType}" Width="*"/>
                                        <DataGridTextColumn Header="Filled (+/-)" Binding="{Binding FilledChange}" Width="90"/>
                                        <DataGridTextColumn Header="Empty (+/-)" Binding="{Binding EmptyChange}" Width="90"/>
                                        <DataGridTextColumn Header="Details" Binding="{Binding TransactionType}" Width="220"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Label Content="Reversal Reason:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#C0392B"/>
                                    <ComboBox x:Name="PlantReversalReasonCombo" Width="260" Height="30" Margin="8,0,0,0" SelectedIndex="0">
                                        <ComboBoxItem Content="Data Entry Mistake"/>
                                        <ComboBoxItem Content="Wrong Product Selected"/>
                                        <ComboBoxItem Content="Duplicate Entry"/>
                                        <ComboBoxItem Content="Wrong Quantity Entered"/>
                                    </ComboBox>
                                    <Button x:Name="ReversePlantPurchaseButton" Content="Reverse Selected Entry" Click="ReversePlantPurchaseButton_Click" Background="#C0392B" Foreground="White" FontWeight="Bold" Height="30" Width="180" Margin="12,0,0,0"/>
                                    <Button x:Name="RefreshPlantPurchaseHistoryButton" Content="Refresh List" Click="RefreshPlantPurchaseHistoryButton_Click" Background="#566573" Foreground="White" Height="30" Width="100" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Admin Tab -->
            <TabItem x:Name="AdminTab" Header="Admin" Padding="10,5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <TextBlock Text="Admin — Owner Only" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" Foreground="#7D3C98"/>
                        <TextBlock Text="Manage warehouses, drivers, and vehicles. Add at least one warehouse before daily operations can begin." FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Drivers Management -->
                            <Border Grid.Column="0" Background="#FBF7FF" Padding="12" CornerRadius="6" BorderBrush="#E8DAEF" BorderThickness="1" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Drivers" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBox x:Name="NewDriverName" Width="180" Height="28" VerticalContentAlignment="Center" />
                                        <Button x:Name="AddDriverBtn" Content="Add" Width="70" Margin="8,0,0,0" Click="AddDriverBtn_Click"/>
                                        <Button x:Name="UpdateDriverBtn" Content="Update" Width="70" Margin="8,0,0,0" Click="UpdateDriverBtn_Click"/>
                                    </StackPanel>
                                    <ListBox x:Name="DriverListBox" Height="180" DisplayMemberPath="Name" SelectionChanged="DriverListBox_SelectionChanged"/>
                                    <Button x:Name="RemoveDriverBtn" Content="Remove Selected Driver" Margin="0,8,0,0" Click="RemoveDriverBtn_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Vehicles Management -->
                            <Border Grid.Column="1" Background="#F3FEFF" Padding="12" CornerRadius="6" BorderBrush="#D6F5F8" BorderThickness="1" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Vehicles" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBox x:Name="NewVehicleNumber" Width="180" Height="28" VerticalContentAlignment="Center" />
                                        <Button x:Name="AddVehicleBtn" Content="Add" Width="70" Margin="8,0,0,0" Click="AddVehicleBtn_Click"/>
                                        <Button x:Name="UpdateVehicleBtn" Content="Update" Width="70" Margin="8,0,0,0" Click="UpdateVehicleBtn_Click"/>
                                    </StackPanel>
                                    <ListBox x:Name="VehicleListBox" Height="180" DisplayMemberPath="VehicleNumber" SelectionChanged="VehicleListBox_SelectionChanged"/>
                                    <Button x:Name="RemoveVehicleBtn" Content="Remove Selected Vehicle" Margin="0,8,0,0" Click="RemoveVehicleBtn_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="Note: Changes here affect driver/vehicle drop-downs used in Morning/Evening operations." FontSize="12" Foreground="#7F8C8D"/>

                        <!-- Warehouses Management -->
                        <TextBlock Text="Warehouses" FontSize="14" FontWeight="Bold" Margin="0,20,0,8"/>
                        <Border Background="#FFF3CD" Padding="12" CornerRadius="6" BorderBrush="#FFC107" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBox x:Name="NewWarehouseName" Width="200" Height="28" VerticalContentAlignment="Center" />
                                    <Button x:Name="AddWarehouseBtn" Content="Add Warehouse" Width="100" Margin="8,0,0,0" Click="AddWarehouseBtn_Click"/>
                                </StackPanel>
                                <ListBox x:Name="WarehouseListBox" Height="150" DisplayMemberPath="Name"/>
                                <Button x:Name="RemoveWarehouseBtn" Content="Remove Selected Warehouse" Margin="0,8,0,0" Click="RemoveWarehouseBtn_Click"/>
                                <TextBlock Text="⚠ Warning: Removing a warehouse will affect all related stock data." FontSize="11" Foreground="#DC3545" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Master Stock Update Tab (Owner only) -->
            <TabItem x:Name="MasterStockTab" Header="Master Stock Update" Padding="10,5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <TextBlock Text="Master Stock Update (Initial / Installation Stock)" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="#B03A2E"/>
                        <TextBlock Text="This screen sets absolute stock for the selected warehouse. Use only during installation or correction."
                                   FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,15"/>

                        <Border Background="#FDEDEC" Padding="12" CornerRadius="6" BorderBrush="#F5B7B1" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Edit Filled/Empty quantities below, then click Save Master Stock."
                                           FontSize="12" FontWeight="Bold" Foreground="#943126"/>
                            </StackPanel>
                        </Border>

                        <DataGrid x:Name="MasterStockDataGrid" AutoGenerateColumns="False" IsReadOnly="False" Background="White" Height="300" BorderBrush="#D5DBDB"
                                  CanUserAddRows="False" CanUserDeleteRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cylinder Type" Binding="{Binding CylinderType}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Filled" Binding="{Binding FilledQty, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                <DataGridTextColumn Header="Empty" Binding="{Binding EmptyQty, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Button x:Name="SaveMasterStockButton" Content="Save Master Stock" Click="SaveMasterStockButton_Click"
                                Background="#C0392B" Foreground="White" Width="200" Height="38" Margin="0,15,0,0" FontWeight="Bold"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Morning Operations Tab -->
            <TabItem x:Name="MorningOutTab" Header="Morning Out" Padding="10,5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <TextBlock Text="Morning Operations (Out)" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="#5D6D7E"/>

                        <Border Background="#F4F6F7" Padding="15" CornerRadius="5" BorderBrush="#D5DBDB" BorderThickness="1" Margin="0,0,0,15">
                            <StackPanel>
                                <UniformGrid Columns="2" Margin="0,0,0,15">
                                    <StackPanel Margin="0,0,10,0">
                                        <Label Content="Driver:" Padding="0" FontSize="12" FontWeight="Bold"/>
                                        <ComboBox x:Name="MorningDriverCombo" DisplayMemberPath="DisplayName" SelectedValuePath="Id" Height="32" SelectionChanged="MorningDriverVehicle_SelectionChanged">
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem">
                                                    <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Margin="10,0,0,0">
                                        <Label Content="Vehicle:" Padding="0" FontSize="12" FontWeight="Bold"/>
                                        <ComboBox x:Name="MorningVehicleCombo" DisplayMemberPath="DisplayName" SelectedValuePath="Id" Height="32" SelectionChanged="MorningDriverVehicle_SelectionChanged">
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem">
                                                    <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                        </ComboBox>
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Text="Products to Send Out:" FontSize="12" FontWeight="Bold" Margin="0,5,0,10" Foreground="#2C3E50"/>
                                <ItemsControl x:Name="MorningProductEntryList" Height="180">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Width="200">
                                                    <TextBlock Text="{Binding ProductName}" FontSize="11"/>
                                                </CheckBox>
                                                <Label Content="Qty:" VerticalAlignment="Center" Padding="5,0,2,0" FontSize="11"/>
                                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="60" Height="24" VerticalContentAlignment="Center" FontSize="11"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <Button x:Name="SaveButton" Content="Save Out" Click="SaveButton_Click" Height="36" Margin="0,15,0,0" Background="#3498DB" Foreground="White" FontWeight="Bold" FontSize="13" IsEnabled="False"/>
                            </StackPanel>
                        </Border>

                        <!-- Stock Grid Below Morning Operations -->
                        <TextBlock Text="Current Warehouse Stock" FontSize="13" FontWeight="Bold" Margin="0,15,0,10" Foreground="#2C3E50"/>
                        <DataGrid x:Name="StockDataGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="White" Height="220" BorderBrush="#D5DBDB">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cylinder Type" Binding="{Binding CylinderType}" Width="*"/>
                                <DataGridTextColumn Header="Filled" Binding="{Binding FilledQty}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Empty" Binding="{Binding EmptyQty}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Accounting & Settlement Tab -->
            <TabItem x:Name="EveningInTab" Header="Evening In" Padding="10,5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <TextBlock Text="Accounting &amp; Settlement" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="#148F77"/>

                        <Border x:Name="NoMorningOutBanner" Background="#FEF9E7" Padding="12" CornerRadius="5" BorderBrush="#F4D03F" BorderThickness="1" Margin="0,0,0,15" Visibility="Collapsed">
                            <TextBlock x:Name="NoMorningOutBannerText" TextWrapping="Wrap" Foreground="#7D6608" FontWeight="SemiBold" FontSize="13"
                                       Text="Evening In is disabled until at least one Morning Out entry is saved for today."/>
                        </Border>

                        <Border x:Name="SettlementCompletedBanner" Background="#FDEDEC" Padding="12" CornerRadius="5" BorderBrush="#E74C3C" BorderThickness="1" Margin="0,0,0,15" Visibility="Collapsed">
                            <TextBlock x:Name="SettlementCompletedText" TextWrapping="Wrap" Foreground="#C0392B" FontWeight="SemiBold" FontSize="13"/>
                        </Border>

                        <Border Background="#E8F8F5" Padding="15" CornerRadius="5" BorderBrush="#D5DBDB" BorderThickness="1" Margin="0,0,0,15">
                            <StackPanel>
                                <StackPanel x:Name="EveningSelectionPanel">
                                    <UniformGrid Columns="2" Margin="0,0,0,15">
                                        <StackPanel Margin="0,0,10,0">
                                            <Label Content="Driver:" Padding="0" FontSize="12" FontWeight="Bold"/>
                                            <ComboBox x:Name="EveningDriverCombo" DisplayMemberPath="DisplayName" SelectedValuePath="Id" Height="32" SelectionChanged="EveningDriverVehicle_SelectionChanged">
                                                <ComboBox.ItemContainerStyle>
                                                    <Style TargetType="ComboBoxItem">
                                                        <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                                                    </Style>
                                                </ComboBox.ItemContainerStyle>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Margin="10,0,0,0">
                                            <Label Content="Vehicle:" Padding="0" FontSize="12" FontWeight="Bold"/>
                                            <ComboBox x:Name="EveningVehicleCombo" DisplayMemberPath="DisplayName" SelectedValuePath="Id" Height="32" SelectionChanged="EveningDriverVehicle_SelectionChanged">
                                                <ComboBox.ItemContainerStyle>
                                                    <Style TargetType="ComboBoxItem">
                                                        <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                                                    </Style>
                                                </ComboBox.ItemContainerStyle>
                                            </ComboBox>
                                        </StackPanel>
                                    </UniformGrid>

                                    <Border x:Name="NoMorningOutSelectionBanner" Background="#FEF9E7" Padding="10" CornerRadius="4" BorderBrush="#F4D03F" BorderThickness="1" Margin="0,0,0,12" Visibility="Collapsed">
                                        <TextBlock Text="Select a driver and vehicle who completed Morning Out today. Only those trips appear in the lists above."
                                                   TextWrapping="Wrap" Foreground="#7D6608" FontSize="12"/>
                                    </Border>

                                    <Border x:Name="MorningUpliftSummaryPanel" Background="#EBF5FB" Padding="12" CornerRadius="5" BorderBrush="#AED6F1" BorderThickness="1" Margin="0,0,0,12" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="Morning Out — Cylinders Sent" FontWeight="Bold" Foreground="#21618C" Margin="0,0,0,6"/>
                                            <TextBlock x:Name="MorningUpliftSummaryText" TextWrapping="Wrap" Foreground="#1A5276" FontSize="13"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="EveningReturnsPanel">
                                <TextBlock Text="Products Returned:" FontSize="14" FontWeight="Bold" Margin="0,5,0,10" Foreground="#148F77"/>

                                <!-- Column headers for product rows -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Product" Grid.Column="0" FontWeight="Bold" Foreground="#2C3E50"/>
                                    <TextBlock Text="Sent (AM)" Grid.Column="1" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#8E44AD"/>
                                    <TextBlock Text="Empty Qty" Grid.Column="2" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#2980B9"/>
                                    <TextBlock Text="Filled Qty" Grid.Column="3" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#16A085"/>
                                </Grid>

                                <!-- Compact list: product name with inline Empty/Filled inputs -->
                                <ItemsControl x:Name="EveningProductEntryList" MaxHeight="420">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,4" Background="#FFFFFF" Padding="8" BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="4">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="140"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding ProductName}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" Text="{Binding MorningUpliftLabel}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               FontWeight="Bold" Foreground="#8E44AD" FontSize="13"/>

                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120" Height="36" VerticalContentAlignment="Center" Padding="6" FontSize="14" ToolTip="Empty cylinders returned" Background="#EBF5FB" Foreground="#1C2833" BorderThickness="2" BorderBrush="#3498DB">
                                                            <TextBox.IsEnabled>
                                                                <Binding Path="IsSelected"/>
                                                            </TextBox.IsEnabled>
                                                        </TextBox>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBox Text="{Binding EmptyQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120" Height="36" VerticalContentAlignment="Center" Padding="6" FontSize="14" ToolTip="Unsold filled cylinders" Background="#E8F8F5" Foreground="#1C2833" BorderThickness="2" BorderBrush="#16A085">
                                                            <TextBox.IsEnabled>
                                                                <Binding Path="IsSelected"/>
                                                            </TextBox.IsEnabled>
                                                        </TextBox>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <StackPanel Margin="0,15,0,0">
                                    <Label Content="Shortage Reason:" Padding="0,0,0,5" FontSize="11" Foreground="Red" FontWeight="Bold"/>
                                    <ComboBox x:Name="MissingReasonCombo" Height="28" Visibility="Collapsed" SelectionChanged="MissingReasonCombo_SelectionChanged">
                                        <ComboBoxItem Content="SBC to DBC (1 Cylinder)" Tag="SBC_TO_DBC"/>
                                        <ComboBoxItem Content="NEW SBC (1 Cylinder)" Tag="NEW_SBC"/>
                                        <ComboBoxItem Content="NEW DBC (2 Cylinders)" Tag="NEW_DBC"/>
                                        <ComboBoxItem Content="HOTEL BAKI (Commercial)" Tag="HOTEL_BAKI"/>
                                        <ComboBoxItem Content="OTHER" Tag="OTHER"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Margin="0,10,0,0" x:Name="HotelSelectionPanel" Visibility="Collapsed">
                                    <Label Content="Select Hotel:" Padding="0,0,0,5" FontSize="11" Foreground="#E74C3C" FontWeight="Bold"/>
                                    <ComboBox x:Name="HotelNameCombo" Height="28">
                                        <ComboBoxItem Content="CUSTOMER F"/>
                                        <ComboBoxItem Content="CUSTOMER G"/>
                                        <ComboBoxItem Content="CUSTOMER H"/>
                                        <ComboBoxItem Content="CUSTOMER C"/>
                                        <ComboBoxItem Content="CUSTOMER D"/>
                                        <ComboBoxItem Content="CUSTOMER E"/>
                                        <ComboBoxItem Content="CUSTOMER I"/>
                                        <ComboBoxItem Content="CUSTOMER J"/>
                                        <ComboBoxItem Content="CUSTOMER K"/>
                                        <ComboBoxItem Content="CUSTOMER A"/>
                                        <ComboBoxItem Content="CUSTOMER B"/>
                                        <ComboBoxItem Content="OTHER"/>
                                    </ComboBox>
                                </StackPanel>

                                <Label Content="Customer Name:" Padding="0,10,0,0" FontSize="11" FontWeight="SemiBold"/>
                                <TextBox x:Name="CustomerNameInput" Height="28" VerticalContentAlignment="Center"/>

                                <Button x:Name="ReturnButton" Content="Save &amp; Complete Settlement" Click="ReturnButton_Click" Height="36" Margin="0,15,0,0" Background="#16A085" Foreground="White" FontWeight="Bold" FontSize="13" IsEnabled="False"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Stock Grid Below Evening Operations -->
                        <TextBlock Text="Current Warehouse Stock" FontSize="13" FontWeight="Bold" Margin="0,15,0,10" Foreground="#2C3E50"/>
                        <DataGrid x:Name="StockDataGridEvening" AutoGenerateColumns="False" IsReadOnly="True" Background="White" Height="220" BorderBrush="#D5DBDB">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cylinder Type" Binding="{Binding CylinderType}" Width="*"/>
                                <DataGridTextColumn Header="Filled" Binding="{Binding FilledQty}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Empty" Binding="{Binding EmptyQty}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Commercial Ledger Tab -->
            <TabItem x:Name="CommercialLedgerTab" Header="Commercial Ledger" Padding="10,5">
                <Grid Background="#F8F9F9" Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="19kg Commercial — Due Payments &amp; Empty Cylinders" FontSize="18" FontWeight="Bold" Foreground="#922B21" Margin="0,0,0,12"/>

                    <Border Grid.Row="1" Background="#FDEDEC" Padding="12" CornerRadius="5" BorderBrush="#F5B7B1" BorderThickness="1" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,30,0">
                                <TextBlock Text="Total Payment Due (All Customers)" FontSize="11" Foreground="#7B241C"/>
                                <TextBlock x:Name="LedgerTotalAmountDueText" Text="₹0.00" FontSize="20" FontWeight="Bold" Foreground="#C0392B"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Total Empty 19kg Cylinders Due" FontSize="11" Foreground="#7B241C"/>
                                <TextBlock x:Name="LedgerTotalEmptyDueText" Text="0" FontSize="20" FontWeight="Bold" Foreground="#2980B9"/>
                            </StackPanel>
                            <Button x:Name="LedgerRefreshBtn" Content="Refresh" Width="100" Height="32" Margin="30,8,0,0"
                                    Background="#922B21" Foreground="White" FontWeight="Bold" Click="LedgerRefreshBtn_Click"/>
                            <Button x:Name="LedgerImportRegisterBtn" Content="Import Register..." Width="140" Height="32" Margin="10,8,0,0"
                                    Background="#1E8449" Foreground="White" FontWeight="Bold" Click="LedgerImportRegisterBtn_Click"/>
                            <Button x:Name="LedgerDownloadTemplateBtn" Content="Sample CSV" Width="100" Height="32" Margin="10,8,0,0"
                                    Background="#566573" Foreground="White" FontWeight="Bold" Click="LedgerDownloadTemplateBtn_Click"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="380"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" Padding="10" CornerRadius="5" BorderBrush="#D5DBDB" BorderThickness="1" Margin="0,0,10,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Customer Balances" FontWeight="Bold" FontSize="13" Foreground="#2C3E50" Margin="0,0,0,8"/>
                                <DataGrid x:Name="LedgerCustomerGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                          SelectionMode="Single" SelectionChanged="LedgerCustomerGrid_SelectionChanged"
                                          AlternatingRowBackground="#FDFEFE">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Customer" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Consumer ID" Binding="{Binding ConsumerId}" Width="90"/>
                                        <DataGridTextColumn Header="Payment Due (₹)" Binding="{Binding AmountDue, StringFormat=N2}" Width="110"/>
                                        <DataGridTextColumn Header="Empty 19kg Due" Binding="{Binding EmptyCylindersDue}" Width="100"/>
                                        <DataGridTextColumn Header="Last Activity" Binding="{Binding LastTransactionAt, StringFormat=dd-MMM-yyyy HH:mm}" Width="130"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="#EBF5FB" Padding="12" CornerRadius="5" BorderBrush="#AED6F1" BorderThickness="1" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Record Transaction" FontWeight="Bold" FontSize="13" Foreground="#21618C" Margin="0,0,0,10"/>
                                        <Label Content="Customer:" Padding="0,0,0,2" FontSize="11" FontWeight="Bold"/>
                                        <ComboBox x:Name="LedgerCustomerCombo" DisplayMemberPath="Name" SelectedValuePath="Id"
                                                  Height="30" Margin="0,0,0,4" IsEditable="True" IsTextSearchEnabled="True"
                                                  StaysOpenOnEdit="True" TextSearch.TextPath="Name"/>
                                        <TextBlock Text="Type to search imported customers" FontSize="9" Foreground="#7F8C8D" Margin="0,0,0,8"/>
                                        <Label Content="Transaction Type:" Padding="0,0,0,2" FontSize="11" FontWeight="Bold"/>
                                        <ComboBox x:Name="LedgerEntryTypeCombo" Height="30" SelectionChanged="LedgerEntryTypeCombo_SelectionChanged" Margin="0,0,0,8">
                                            <ComboBoxItem Content="19kg Credit Sale (Baki)" Tag="CreditSale19kg"/>
                                            <ComboBoxItem Content="Payment Received" Tag="PaymentReceived"/>
                                            <ComboBoxItem Content="Empty Cylinder Returned" Tag="EmptyReturned"/>
                                            <ComboBoxItem Content="Manual Adjustment" Tag="Adjustment"/>
                                        </ComboBox>
                                        <Label x:Name="LedgerAmountLabel" Content="Sale Amount (₹):" Padding="0,0,0,2" FontSize="11" FontWeight="Bold"/>
                                        <TextBox x:Name="LedgerAmountInput" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                                        <Label x:Name="LedgerQtyLabel" Content="19kg Cylinders (Qty):" Padding="0,0,0,2" FontSize="11" FontWeight="Bold"/>
                                        <TextBox x:Name="LedgerQtyInput" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                                        <Label Content="Notes:" Padding="0,0,0,2" FontSize="11" FontWeight="Bold"/>
                                        <TextBox x:Name="LedgerNotesInput" Height="50" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>
                                        <Button x:Name="LedgerSaveEntryBtn" Content="Save to Ledger" Height="34" Background="#21618C" Foreground="White" FontWeight="Bold" Click="LedgerSaveEntryBtn_Click"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#E8F8F5" Padding="12" CornerRadius="5" BorderBrush="#A3E4D7" BorderThickness="1" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Import Customer Register" FontWeight="Bold" FontSize="13" Foreground="#0E6251" Margin="0,0,0,6"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#117A65" Margin="0,0,0,4"
                                                   Text="Import your IOCL customer register CSV (export from Excel). All 44 columns are accepted; key fields are mapped automatically."/>
                                        <TextBlock x:Name="LedgerColumnGuideText" TextWrapping="Wrap" FontSize="9" Foreground="#1A5276" Margin="0,0,0,6"/>
                                        <CheckBox x:Name="LedgerImportCommercialOnlyCheck" Content="Import only Commercial / 19kg customers"
                                                  IsChecked="True" FontSize="10" Foreground="#0E6251" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Button x:Name="LedgerImportFromFileBtn" Content="Choose File &amp; Import" Height="30" Width="150"
                                                    Background="#1E8449" Foreground="White" FontWeight="Bold" Click="LedgerImportRegisterBtn_Click"/>
                                            <Button Content="Sample CSV" Height="30" Width="90" Margin="8,0,0,0"
                                                    Background="#566573" Foreground="White" FontWeight="Bold" Click="LedgerDownloadTemplateBtn_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="LedgerImportStatusText" Text="" FontSize="10" Foreground="#0E6251" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F4ECF7" Padding="12" CornerRadius="5" BorderBrush="#D7BDE2" BorderThickness="1" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Add New Customer" FontWeight="Bold" FontSize="13" Foreground="#6C3483" Margin="0,0,0,8"/>
                                        <Label Content="Name:" Padding="0,0,0,2" FontSize="11"/>
                                        <TextBox x:Name="LedgerNewCustomerNameInput" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,6"/>
                                        <Label Content="Phone (optional):" Padding="0,0,0,2" FontSize="11"/>
                                        <TextBox x:Name="LedgerNewCustomerPhoneInput" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                                        <Button x:Name="LedgerAddCustomerBtn" Content="Add Customer" Height="30" Background="#8E44AD" Foreground="White" FontWeight="Bold" Click="LedgerAddCustomerBtn_Click"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="White" Padding="10" CornerRadius="5" BorderBrush="#D5DBDB" BorderThickness="1">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="Transaction History" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                            <CheckBox x:Name="LedgerFilterByCustomerCheck" Content="Selected customer only" Margin="15,0,0,0" VerticalAlignment="Center" Checked="LedgerFilterChanged" Unchecked="LedgerFilterChanged"/>
                                        </StackPanel>
                                        <DataGrid x:Name="LedgerHistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="280" AlternatingRowBackground="#F9F9F9">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Date" Binding="{Binding Timestamp, StringFormat=dd-MMM HH:mm}" Width="90"/>
                                                <DataGridTextColumn Header="Type" Binding="{Binding EntryTypeDisplay}" Width="110"/>
                                                <DataGridTextColumn Header="₹ Change" Binding="{Binding AmountChange, StringFormat=N2}" Width="70"/>
                                                <DataGridTextColumn Header="Empty Δ" Binding="{Binding EmptyCylinderChange}" Width="55"/>
                                                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Border Grid.Row="3" Background="#2C3E50" Padding="10" CornerRadius="4" Margin="0,12,0,0">
                        <TextBlock x:Name="LedgerSelectedCustomerSummaryText" Foreground="White" FontWeight="SemiBold" Text="Select a customer to view balance details."/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Stock Reports Tab -->
            <TabItem x:Name="StockReportTab" Header="Stock Report" Padding="10,5">
                <Grid Background="#F4F7F9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="20">
                        <TextBlock Text="Transaction History" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="From:" VerticalAlignment="Center" Margin="20,0,5,0"/>
                        <DatePicker x:Name="FromDatePicker" Width="120"/>
                        <TextBlock Text="To:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                        <DatePicker x:Name="ToDatePicker" Width="120"/>
                        <Button x:Name="FilterBtn" Content="Filter" Width="80" Margin="10,0,0,0" Background="#27AE60" Foreground="White" Click="FilterBtn_Click"/>
                        <Button x:Name="RefreshReportBtn" Content="Show All" Width="100" Margin="10,0,0,0" Background="#3498DB" Foreground="White" Click="RefreshReportBtn_Click"/>
                        <Button x:Name="ExportBtn" Content="Export CSV" Width="100" Margin="10,0,0,0" Background="#8E44AD" Foreground="White" Click="ExportBtn_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="ReportsGrid" Grid.Row="1" Margin="20,0,20,70" AutoGenerateColumns="False" IsReadOnly="True" Background="White" AlternatingRowBackground="#F9F9F9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date/Time" Binding="{Binding Timestamp}" Width="140"/>
                            <DataGridTextColumn Header="Warehouse" Binding="{Binding WarehouseName}" Width="120"/>
                            <DataGridTextColumn Header="Product" Binding="{Binding CylinderType}" Width="140"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding TransactionType}" Width="150"/>
                            <DataGridTextColumn Header="Filled (+/-)" Binding="{Binding FilledChange}" Width="90"/>
                            <DataGridTextColumn Header="Empty (+/-)" Binding="{Binding EmptyChange}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" VerticalAlignment="Bottom" Background="#2C3E50" Height="50" Margin="20,0,20,15" CornerRadius="5">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,20,0">
                            <TextBlock Text="Total Net Filled:" Foreground="White" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock x:Name="TotalFilledText" Text="0" Foreground="#F1C40F" VerticalAlignment="Center" Margin="10,0,20,0" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="Total Net Empty:" Foreground="White" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock x:Name="TotalEmptyText" Text="0" Foreground="#F1C40F" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold" FontSize="16"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Accounting Tab -->
            <TabItem x:Name="AccountingTab" Header="Accounting Tab" Padding="10,5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <TextBlock Text="Accounting &amp; Settlement" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="#8E44AD"/>

                        <!-- Saved Accounting Lookup -->
                        <Border x:Name="AcctHistoryPanel" Background="#F8F9F9" Padding="15" CornerRadius="5" BorderBrush="#D5DBDB" BorderThickness="1" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Saved Accounting Lookup" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="#2C3E50"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <DatePicker x:Name="AcctHistoryFromDate" Width="130" Margin="0,0,12,0"/>
                                    <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <DatePicker x:Name="AcctHistoryToDate" Width="130" Margin="0,0,12,0"/>
                                    <Button x:Name="LoadAcctHistoryBtn" Content="Load" Width="80" Height="30" Margin="0,0,8,0"
                                            Background="#8E44AD" Foreground="White" FontWeight="Bold" Click="LoadAcctHistoryBtn_Click"/>
                                    <Button x:Name="ShowAllAcctHistoryBtn" Content="Show All" Width="90" Height="30"
                                            Background="#3498DB" Foreground="White" FontWeight="Bold" Click="ShowAllAcctHistoryBtn_Click"/>
                                </StackPanel>
                                <DataGrid x:Name="AcctHistoryGrid" Height="160" AutoGenerateColumns="False" IsReadOnly="True"
                                          SelectionMode="Single" SelectionChanged="AcctHistoryGrid_SelectionChanged"
                                          Background="White" AlternatingRowBackground="#F4F6F7" Margin="0,0,0,10">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Date" Binding="{Binding SettlementDateDisplay}" Width="110"/>
                                        <DataGridTextColumn Header="Driver" Binding="{Binding DriverName}" Width="*"/>
                                        <DataGridTextColumn Header="Vehicle" Binding="{Binding VehicleNumber}" Width="*"/>
                                        <DataGridTextColumn Header="Refills" Binding="{Binding RefillsDisplay}" Width="80"/>
                                        <DataGridTextColumn Header="Total" Binding="{Binding TotalCollectionDisplay}" Width="90"/>
                                        <DataGridTextColumn Header="Saved At" Binding="{Binding SavedAtDisplay}" Width="130"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="ViewAcctHistoryBtn" Content="View Details" Width="120" Height="30" Margin="0,0,10,0"
                                            Background="#27AE60" Foreground="White" FontWeight="Bold" Click="ViewAcctHistoryBtn_Click"/>
                                    <Button x:Name="PrintAcctHistoryBtn" Content="Print" Width="90" Height="30"
                                            Background="#E67E22" Foreground="White" FontWeight="Bold" Click="PrintAcctHistoryBtn_Click"/>
                                </StackPanel>
                                <TextBox x:Name="AcctHistoryDetailText" Height="180" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         IsReadOnly="True" Background="#FFFFFF" FontFamily="Consolas" FontSize="11"
                                         Text="Select a saved accounting record above to view details."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="New Accounting Entry" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="#8E44AD"/>

                        <Border x:Name="NoEveningForAccountingBanner" Background="#FEF9E7" Padding="12" CornerRadius="5" BorderBrush="#F4D03F" BorderThickness="1" Margin="0,0,0,15" Visibility="Collapsed">
                            <TextBlock TextWrapping="Wrap" Foreground="#7D6608" FontWeight="SemiBold" FontSize="13"
                                       Text="Accounting is disabled until at least one Evening In settlement is completed for the working date."/>
                        </Border>

                        <Border x:Name="NoAccountingPendingBanner" Background="#EBF5FB" Padding="12" CornerRadius="5" BorderBrush="#AED6F1" BorderThickness="1" Margin="0,0,0,15" Visibility="Collapsed">
                            <TextBlock x:Name="NoAccountingPendingBannerText" TextWrapping="Wrap" Foreground="#1B4F72" FontWeight="SemiBold" FontSize="13"
                                       Text="All driver/vehicle trips have been accounted for today."/>
                        </Border>

                        <Border x:Name="AcctSelectTripBanner" Background="#F4ECF7" Padding="12" CornerRadius="5" BorderBrush="#D7BDE2" BorderThickness="1" Margin="0,0,0,15" Visibility="Collapsed">
                            <TextBlock TextWrapping="Wrap" Foreground="#6C3483" FontWeight="SemiBold" FontSize="13"
                                       Text="Select a driver and vehicle with pending accounting (Evening In completed, accounting not yet saved)."/>
                        </Border>

                        <Border Background="#F4ECF7" Padding="15" CornerRadius="5" BorderBrush="#D7BDE2" BorderThickness="1" Margin="0,0,0,15">
                            <StackPanel x:Name="AcctSelectionPanel">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,20,0">
                                        <Label Content="Working Date:" FontWeight="Bold"/>
                                        <DatePicker x:Name="AcctDatePicker" Width="160" IsEnabled="False"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,20,0">
                                        <Label Content="Driver:" FontWeight="Bold"/>
                                        <ComboBox x:Name="AcctDriverCombo" Width="180" DisplayMemberPath="Name" SelectedValuePath="Id"
                                                  SelectionChanged="AcctDriverVehicle_SelectionChanged"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <Label Content="Vehicle:" FontWeight="Bold"/>
                                        <ComboBox x:Name="AcctVehicleCombo" Width="180" DisplayMemberPath="VehicleNumber" SelectedValuePath="Id"
                                                  SelectionChanged="AcctDriverVehicle_SelectionChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="AcctFormPanel">

                        <!-- Summary Section -->
                        <Border Background="#E8F8F5" Padding="15" CornerRadius="5" BorderBrush="#A3E4D7" BorderThickness="1" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Daily Summary" FontSize="13" FontWeight="Bold" Margin="0,0,0,10" Foreground="#0E6251"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <TextBlock Text="Cylinders Sold:" FontWeight="Bold" Width="150"/>
                                            <TextBlock x:Name="CylindersSoldText" Text="0" Foreground="#27AE60" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <TextBlock Text="Expected Refills:" FontWeight="Bold" Width="150"/>
                                            <TextBlock x:Name="AcctExpectedRefillsText" Text="0" Foreground="#8E44AD" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <TextBlock Text="Refills Entered:" FontWeight="Bold" Width="150"/>
                                            <TextBlock x:Name="RefillsCountText" Text="0 / 0" Foreground="#3498DB" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <TextBlock Text="Unsold Filled:" FontWeight="Bold" Width="150"/>
                                            <TextBlock x:Name="UnsoldFilledText" Text="0" Foreground="#E74C3C" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <TextBlock Text="Empties Returned:" FontWeight="Bold" Width="150"/>
                                            <TextBlock x:Name="EmptiesReturnedText" Text="0" Foreground="#95A5A6" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Payment Section -->
                        <Border Background="#FCF3CF" Padding="15" CornerRadius="5" BorderBrush="#F9E79F" BorderThickness="1" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Payment Collection" FontSize="13" FontWeight="Bold" Margin="0,0,0,10" Foreground="#7D6608"/>
                                <!-- Misc Sales -->
                                <TextBlock Text="Misc Sales:" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" Foreground="#9A7D0A"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
